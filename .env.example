APP_NAME="Enterprise Knowledge Base RAG Agent"
DATA_DIR="data"

# qwen: use Qwen text-embedding-v4 through DashScope OpenAI-compatible API.
# local: use local hash embedding only for offline tests.
EMBEDDING_PROVIDER="qwen"

# qwen: use Qwen LLM through DashScope OpenAI-compatible API.
# local: use a no-key demo answer generator only for offline tests.
CHAT_PROVIDER="qwen"

QWEN_API_KEY=""
DASHSCOPE_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_CHAT_MODEL="qwen-plus"
QWEN_EMBEDDING_MODEL="text-embedding-v4"
QWEN_EMBEDDING_DIMENSIONS=1024

# mineru_api: parse PDF with official MinerU API Token flow.
# pypdf: fallback plain text parser.
PDF_PARSER="mineru_api"
MINERU_API_BASE_URL="https://mineru.net/api/v4"
MINERU_API_TOKEN=""
MINERU_MODEL_VERSION="vlm"
MINERU_LANGUAGE="ch"
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=true
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_TIMEOUT_SECONDS=600
MINERU_FALLBACK_TO_PYPDF=false

# Optional OpenAI-compatible API settings.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
CHAT_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# RAGAS evaluation uses DeepSeek as judge LLM.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_CHAT_MODEL="deepseek-chat"

CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
EMBEDDING_BATCH_SIZE=10
