APP_NAME="Enterprise Knowledge Base RAG Agent"
DATA_DIR="data"

# PostgreSQL 业务数据库配置。
# Docker Compose 会把主机名自动改为 postgres；本地 Python 启动使用 localhost。
DATABASE_URL="postgresql+psycopg://rag:local-only-change-me@localhost:5432/rag"
POSTGRES_DB="rag"
POSTGRES_USER="rag"
# 如果要在本机以外访问 PostgreSQL，请先修改这个演示密码，并额外配置网络安全策略。
POSTGRES_PASSWORD="local-only-change-me"
POSTGRES_PORT=5432

# Docker Compose 对外暴露的宿主机端口。
RAG_PORT=8000

# qwen：通过阿里云百炼的 OpenAI 兼容接口调用 Qwen Embedding v4。
EMBEDDING_PROVIDER="qwen"

# deepseek：用于 RAG 回答、Dynamic RAG 和 Agent 路由。
CHAT_PROVIDER="deepseek"

# Qwen Embedding 配置。填写阿里云百炼控制台创建的 API Key。
QWEN_API_KEY=""
# Qwen 官方兼容接口地址；这是接口域名，不代表项目还有另一套 Embedding Provider。
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_EMBEDDING_MODEL="text-embedding-v4"
QWEN_EMBEDDING_DIMENSIONS=1024

# mineru_api：通过 MinerU 官方 API Token 解析复杂文档。
# pypdf：纯文本 PDF 解析兜底方案。
PDF_PARSER="mineru_api"
MINERU_API_BASE_URL="https://mineru.net/api/v4"
MINERU_API_TOKEN=""
MINERU_MODEL_VERSION="vlm"
MINERU_LANGUAGE="ch"
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=true
MINERU_POLL_INTERVAL_SECONDS=2
MINERU_TIMEOUT_SECONDS=600
# MinerU 单次请求最大页数；超过后项目会自动拆分 PDF，逐片解析后合并 Markdown。
MINERU_MAX_PAGES_PER_REQUEST=200
MINERU_FALLBACK_TO_PYPDF=false

# 下面是可选的 OpenAI 兼容接口配置，当前默认不使用。
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
CHAT_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# RAGAS 评估使用 DeepSeek 作为裁判模型。
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_CHAT_MODEL="deepseek-chat"
# Agent 默认开启思考模式；前端只展示阶段摘要，不展示原始隐藏思维链。
# 如需降低耗时和 Token 消耗，可改为 disabled；轨迹仍会显示模型分析阶段。
DEEPSEEK_THINKING_TYPE="enabled"

# Tavily 联网搜索配置。工作台开关关闭时不会调用；开启后仅在知识库证据不足时兜底。
TAVILY_API_KEY=""
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH="basic"

CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4
EMBEDDING_BATCH_SIZE=10
# Agent 判定知识库证据不足的门槛：来源数不足或 cosine distance 转换后的置信度低时才允许联网兜底。
# Hybrid 的 RRF 分数只用于排序，不作为事实相关性的唯一依据。
KNOWLEDGE_MIN_SOURCES=2
KNOWLEDGE_MIN_CONFIDENCE=0.45

# 混合检索参数：RRF 合并 dense 与 BM25 的候选排名。
HYBRID_RRF_K=60
HYBRID_CANDIDATE_MULTIPLIER=3

# 批量上传的数量、文件大小、并发和重试限制。
MAX_BATCH_FILES=10
MAX_UPLOAD_FILE_SIZE_MB=50
UPLOAD_READ_CHUNK_SIZE=1048576
UPLOAD_CONCURRENCY=2
MAX_UPLOAD_RETRIES=3

# Agent 工具循环和写操作审批配置。
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_CONTEXT_CHARS=12000
# 审批卡默认 30 分钟有效；过期审批不会执行写操作。
AGENT_APPROVAL_TTL_SECONDS=1800

# PostgreSQL 连接池配置。
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=5
DATABASE_STATEMENT_TIMEOUT_MS=60000
